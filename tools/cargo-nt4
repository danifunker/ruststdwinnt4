#!/usr/bin/env bash
# cargo for the NT 4.0 targets, from any project's directory:
#
#   tools/cargo-nt4 build --release -p hello             # in this repository
#   cd ../some-project && ../ruststdwinnt4/tools/cargo-nt4 build --release
#
# It makes the import libraries and the patched std source (tools/mkstd.sh), then runs
# cargo of the pinned toolchain with:
#   - the target (targets/<target>.json), its linker (tools/nt4-link) and the import
#     libraries, set through cargo's environment variables so that any project gets them;
#   - std built for the target from that source (-Zbuild-std, with
#     __CARGO_TESTS_ONLY_SRC_ROOT, cargo's way of taking the standard library's source
#     from elsewhere), with RUSTC_BOOTSTRAP=1 for the -Z flags and the JSON target on a
#     stable release;
#   - the cfgs crates use to pick their Windows backends: getrandom's `windows_legacy`
#     (RtlGenRandom, which nt4compat gives, not Windows 10's ProcessPrng);
#   - NT 4.0 versions of the crates.io crates that need one (tools/nt4-crates.py), as
#     [patch.crates-io] entries for the project in the current directory;
#   - when PINT's SDK is there (tools/pint-sdk), C for the target. On ARM the cc crate
#     compiles with its cl (tools/nt4-cl), on x86 with clang in cl mode and the SDK's
#     NT 4.0 headers (tools/nt4-clang-cl); it archives with rust-lld (tools/nt4-lib), and programs
#     link NT 4.0's C run-time, PINT's msvcrt.dll, ahead of everything else (ntdll also
#     exports some C functions, and C code must take them all from one run-time), and
#     oldnames.lib (the POSIX names), and ruststdwinnt4's C99 layer (crt/, nt4c99.lib).
# Local settings (PINT_SDK, PINT_MSVC) can go in nt4.env at the top of this repository.
# no_std programs do not link std.
#
# After a build, every .exe and .dll cargo made is checked with tools/peinfo.py against
# NT 4.0 SP0's exports (imports/<arch>), and the build fails on an import NT 4.0 lacks.
# NT4_NO_IMPORT_CHECK=1 skips the check.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET=${NT4_TARGET:-thumbv7a-nt4-windows-msvc}
case $TARGET in
    thumbv7a-*) ARCH=arm ;;
    i686-*) ARCH=x86 ;;
    *) echo "cargo-nt4: unknown target $TARGET" >&2; exit 2 ;;
esac
"$ROOT/tools/mkimplibs.sh" "$ARCH"
if [ -f "$ROOT/nt4.env" ]; then set -a; . "$ROOT/nt4.env"; set +a; fi
PINT_SDK=${PINT_SDK:-$ROOT/target/pint40sdk}

# The toolchain of this repository, whatever the project pins.
export RUSTUP_TOOLCHAIN=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' "$ROOT/rust-toolchain.toml")
export __CARGO_TESTS_ONLY_SRC_ROOT="$(cd "$ROOT" && tools/mkstd.sh)"
export RUSTC_BOOTSTRAP=1
V=$(echo "$TARGET" | tr 'a-z-' 'A-Z_')
export CARGO_BUILD_TARGET="$ROOT/targets/$TARGET.json"
export "CARGO_TARGET_${V}_LINKER=$ROOT/tools/nt4-link"
flags="-L native=$ROOT/target/implib/$ARCH --cfg getrandom_backend=\"windows_legacy\""
if [ "$ARCH" = arm ] && [ -d "$PINT_SDK/rootfs/opt/pint40sdk/lib" ]; then
    t=$(echo "$TARGET" | tr - _)
    export "CC_$t=$ROOT/tools/nt4-cl" "AR_$t=$ROOT/tools/nt4-lib"
    # After ours, so NT 4.0's import libraries are the ones found first.
    "$ROOT/crt/build.sh" >/dev/null
    flags="$flags -L native=$PINT_SDK/rootfs/opt/pint40sdk/lib -Z pre-link-arg=msvcrt.lib -C link-arg=oldnames.lib -C link-arg=$ROOT/target/crt/$ARCH/nt4c99.lib"
elif [ "$ARCH" = x86 ] && [ -d "$PINT_SDK/rootfs/opt/pint40sdk/include" ] \
        && { [ -n "${NT4_CLANG:-}" ] || command -v clang-18 >/dev/null || command -v clang >/dev/null; }; then
    # x86: clang in cl mode (tools/nt4-clang-cl) with NT 4.0's headers from PINT's SDK;
    # msvcrt.lib and oldnames.lib are ours (tools/mkimplibs.sh x86).
    t=$(echo "$TARGET" | tr - _)
    export "CC_$t=$ROOT/tools/nt4-clang-cl" "AR_$t=$ROOT/tools/nt4-lib"
    "$ROOT/crt/build.sh" x86 >/dev/null
    flags="$flags -Z pre-link-arg=msvcrt.lib -C link-arg=oldnames.lib -C link-arg=$ROOT/target/crt/$ARCH/nt4c99.lib"
fi
export "CARGO_TARGET_${V}_RUSTFLAGS=$flags ${NT4_RUSTFLAGS:-}"

config=()
if [ -f Cargo.toml ]; then
    while IFS= read -r c; do config+=(--config "$c"); done < <(python3 "$ROOT/tools/nt4-crates.py" .)
fi

cmd=$1; shift
args=(${config[@]+"${config[@]}"} -Zbuild-std=std,panic_abort -Zbuild-std-features=compiler-builtins-mem "$@")
if [ "$cmd" != build ] || [ -n "${NT4_NO_IMPORT_CHECK:-}" ]; then
    exec cargo "$cmd" "${args[@]}"
fi

# build: cargo runs as a child, and every .exe and .dll it reports (built now or already
# fresh) is checked against NT 4.0 SP0's exports (tools/peinfo.py --defs imports/<arch>).
# Cargo's JSON messages name the images; its diagnostics still go to stderr as usual.
# When the caller asked for a --message-format, its messages are passed on unchanged.
fmt=--message-format=json-render-diagnostics
for a in "$@"; do case $a in --message-format*) fmt= ;; esac; done
images=$(mktemp)
trap 'rm -f "$images"' EXIT
set +e
cargo build ${fmt:+"$fmt"} "${args[@]}" | python3 "$ROOT/tools/nt4-artifacts.py" "$images" ${fmt:+--quiet}
status=${PIPESTATUS[0]}
set -e
[ "$status" = 0 ] || exit "$status"
failed=0
while IFS= read -r image; do
    if out=$(python3 "$ROOT/tools/peinfo.py" "$image" --defs "$ROOT/imports/$ARCH" 2>&1); then
        echo "cargo-nt4: $image: imports are in NT 4.0 SP0" >&2
    else
        echo "cargo-nt4: $image fails the NT 4.0 check:" >&2
        # peinfo's errors, or all of its output when it failed some other way.
        printf '%s\n' "$out" | grep '^ERROR' >&2 || printf '%s\n' "$out" >&2
        failed=1
    fi
done < "$images"
[ "$failed" = 0 ] || { echo "cargo-nt4: an image imports what NT 4.0 SP0 lacks (NT4_NO_IMPORT_CHECK=1 skips the check)" >&2; exit 1; }
