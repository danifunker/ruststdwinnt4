#!/usr/bin/env bash
# cargo for the NT 4.0 targets: makes the import libraries, then runs cargo of the pinned
# toolchain building core and alloc for the target (-Zbuild-std), with RUSTC_BOOTSTRAP=1
# for the -Z flags and the JSON target on a stable release.
#
#   tools/cargo-nt4 build --release -p hello
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$ROOT/tools/mkimplibs.sh" arm
cd "$ROOT"
export RUSTC_BOOTSTRAP=1
cmd=$1; shift
exec cargo "$cmd" -Zbuild-std=core,alloc -Zbuild-std-features=compiler-builtins-mem "$@"
