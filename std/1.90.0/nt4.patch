 /// mode. This means that technically speaking it should only ever be used
 /// with `OVERLAPPED` instances, but also works out ok if it's only ever used
 /// once at a time (which we do indeed guarantee).
+/// Windows NT 4.0 cannot make an unnamed pipe with `NtCreateNamedPipeFile`, nor open
+/// one end through the other's handle: the pipe gets a name unique in the system (the
+/// process's id and a counter) and is made the Win32 way, as std did before 1.79. Our
+/// end is overlapped (for `read2`); theirs is synchronous, inheritable if asked.
+#[cfg(target_vendor = "nt4")]
+pub fn anon_pipe(ours_readable: bool, their_handle_inheritable: bool) -> io::Result<Pipes> {
+    use crate::sync::atomic::{AtomicUsize, Ordering};
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    const PIPE_BUFFER_CAPACITY: u32 = 64 * 1024;
+    unsafe {
+        let name: Vec<u16> = format!(
+            r"\\.\pipe\rust-anon-pipe.{}.{}",
+            c::GetCurrentProcessId(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        )
+        .encode_utf16()
+        .chain(Some(0))
+        .collect();
+        let open_mode = if ours_readable { c::PIPE_ACCESS_INBOUND } else { c::PIPE_ACCESS_OUTBOUND }
+            | c::FILE_FLAG_OVERLAPPED;
+        let ours = c::CreateNamedPipeW(
+            name.as_ptr(),
+            open_mode,
+            c::PIPE_TYPE_BYTE | c::PIPE_READMODE_BYTE | c::PIPE_WAIT,
+            1,
+            PIPE_BUFFER_CAPACITY,
+            PIPE_BUFFER_CAPACITY,
+            0,
+            ptr::null(),
+        );
+        if ours == c::INVALID_HANDLE_VALUE {
+            return Err(io::Error::last_os_error());
+        }
+        let ours = Handle::from_raw_handle(ours);
+        let sa = c::SECURITY_ATTRIBUTES {
+            nLength: size_of::<c::SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: ptr::null_mut(),
+            bInheritHandle: their_handle_inheritable as c::BOOL,
+        };
+        let access = if ours_readable { c::GENERIC_WRITE | c::FILE_READ_ATTRIBUTES } else { c::GENERIC_READ };
+        let theirs = c::CreateFileW(name.as_ptr(), access, 0, &sa, c::OPEN_EXISTING, 0, ptr::null_mut());
+        if theirs == c::INVALID_HANDLE_VALUE {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Pipes { ours: AnonPipe { inner: ours }, theirs: AnonPipe { inner: Handle::from_raw_handle(theirs) } })
+    }
+}
